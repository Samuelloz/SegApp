// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String  @id @default(cuid())
  name      String
  legalName String?
  slug      String  @unique
  rfc       String? @unique
  address   String?
  timezone  String  @default("America/Mexico_City")
  active    Boolean @default(true)

  guards      Guard[]
  contracts   Contract[]
  assignments GuardAssignment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @db.Timestamp(6)
}

model Contract {
  id        String  @id @default(cuid())
  name      String
  companyId String
  active    Boolean @default(true)

  assignments GuardAssignment[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @db.Timestamp(6)

  @@index([companyId])
}

model Guard {
  id             String   @id @default(cuid())
  fullName       String
  fatherFullName String
  motherFullName String
  birthDate      DateTime @db.Date
  birthPlace     String
  employeeNumber String
  hiredAt        DateTime @db.Date
  phone          String?
  rfc            String
  curp           String
  nss            String

  street           String?
  exteriorNumber   String?
  interiorNumber   String?
  neighborhood     String?
  postalCode       String?
  city             String?
  municipality     String?
  state            String?
  country          String?
  formattedAddress String?
  latitude         Float?
  longitude        Float?
  externalPlaceId  String?
  companyId        String
  active           Boolean @default(true)

  assignments GuardAssignment[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @db.Timestamp(6)

  @@unique([companyId, employeeNumber])
  @@unique([companyId, rfc])
  @@unique([companyId, curp])
  @@unique([companyId, nss])
}

model GuardAssignment {
  id         String    @id @default(cuid())
  guardId    String
  contractId String
  companyId  String
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  guard    Guard    @relation(fields: [guardId], references: [id], onDelete: Restrict)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([guardId])
  @@index([contractId])
  @@index([endedAt])
  @@index([companyId])
}
