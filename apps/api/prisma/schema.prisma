// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  SALES
  CONTRACT_MANAGER
  GUARD_MANAGER
  SUPERVISOR
  VIEWER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum InvitationDeliveryChannel {
  EMAIL
  WHATSAPP
}

model User {
  id              String    @id @default(cuid())
  companyId       String
  email           String?
  phoneE164       String?
  passwordHash    String
  name            String
  active          Boolean   @default(true)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  membership         CompanyMembership?
  invitationsSent    Invitation[]          @relation("InvitationSender")
  verificationTokens ContactVerification[]
  company            Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, email])
  @@unique([companyId, phoneE164])
  @@unique([id, companyId])
}

model CompanyMembership {
  id        String           @id @default(cuid())
  roles     MembershipRole[] @default([VIEWER])
  status    MembershipStatus @default(ACTIVE)
  companyId String
  userId    String           @unique

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)

  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, companyId])
}

model Session {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  membershipId String
  expiresAt    DateTime
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  ipHash       String?
  userAgent    String?

  membership CompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([membershipId])
  @@index([expiresAt])
}

model Invitation {
  id              String                    @id @default(cuid())
  email           String?
  phoneE164       String?
  deliveryChannel InvitationDeliveryChannel
  roles           MembershipRole[]
  tokenHash       String                    @unique
  companyId       String
  invitedById     String
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invitedBy User    @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([companyId, email])
  @@index([companyId, phoneE164])
  @@index([invitedById])
  @@index([expiresAt])
}

model ContactVerification {
  id              String                    @id @default(cuid())
  tokenHash       String                    @unique
  deliveryChannel InvitationDeliveryChannel
  contactValue    String
  userId          String
  expiresAt       DateTime
  consumedAt      DateTime?
  revokedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, deliveryChannel])
  @@index([expiresAt])
}

model Company {
  id        String  @id @default(cuid())
  name      String
  legalName String?
  slug      String  @unique
  rfc       String? @unique
  address   String?
  timezone  String  @default("America/Mexico_City")
  active    Boolean @default(true)

  guards      Guard[]
  contracts   Contract[]
  assignments GuardAssignment[]
  memberships CompanyMembership[]
  invitations Invitation[]
  users       User[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @db.Timestamp(6)
}

model Contract {
  id                 String    @id @default(cuid())
  name               String
  clientLegalName    String
  clientRfc          String
  startDate          DateTime  @db.Date
  endDate            DateTime? @db.Date
  contactName        String
  contactPhone       String
  contactEmail       String?
  requiredGuardCount Int

  street           String?
  exteriorNumber   String?
  interiorNumber   String?
  neighborhood     String?
  postalCode       String?
  city             String?
  municipality     String?
  state            String?
  country          String?
  formattedAddress String?
  latitude         Float?
  longitude        Float?
  externalPlaceId  String?

  active    Boolean @default(true)
  companyId String

  assignments GuardAssignment[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @db.Timestamp(6)

  @@index([companyId, clientRfc])
}

model Guard {
  id             String   @id @default(cuid())
  fullName       String
  fatherFullName String
  motherFullName String
  birthDate      DateTime @db.Date
  birthPlace     String
  employeeNumber String
  hiredAt        DateTime @db.Date
  phone          String?
  rfc            String
  curp           String
  nss            String

  street           String?
  exteriorNumber   String?
  interiorNumber   String?
  neighborhood     String?
  postalCode       String?
  city             String?
  municipality     String?
  state            String?
  country          String?
  formattedAddress String?
  latitude         Float?
  longitude        Float?
  externalPlaceId  String?
  companyId        String
  active           Boolean @default(true)

  assignments GuardAssignment[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @db.Timestamp(6)

  @@unique([companyId, employeeNumber])
  @@unique([companyId, rfc])
  @@unique([companyId, curp])
  @@unique([companyId, nss])
}

model GuardAssignment {
  id         String    @id @default(cuid())
  guardId    String
  contractId String
  companyId  String
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  guard    Guard    @relation(fields: [guardId], references: [id], onDelete: Restrict)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([guardId])
  @@index([contractId])
  @@index([endedAt])
  @@index([companyId])
}
