generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Contract {
  id        String    @id @default(cuid())
  name      String 
  active    Boolean   @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @db.Timestamp(6)
}

model Guard {
  id              String  @id @default(cuid())
  fullname        String
  employeeNumber  String  @unique
  phone           String?
  active          Boolean     @default (true)
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?   @db.Timestamp(6)
}